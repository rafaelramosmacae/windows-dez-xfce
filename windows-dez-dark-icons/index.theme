[Icon Theme]
Name=windows-dez-dark
Comment=Flat icons for XFCE inspired by Windows 10 (full dark mode) — by Rafael Carvalho Ramos
Inherits=elementary-xfce-dark,elementary-xfce,Adwaita,hicolor
Example=folder
DisplayDepth=32
Directories=scalable/actions,scalable/apps,scalable/categories,scalable/devices,scalable/mimetypes,scalable/places,scalable/status,scalable/panel

[scalable/actions]
Context=Actions
Size=24
MinSize=8
MaxSize=512
Type=Scalable

[scalable/apps]
Context=Applications
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/categories]
Context=Categories
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[scalable/panel]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable
